# Environment variables template for BeautyAI (Technical Design §3.5)
# COPY TO .env (mode 600) AND POPULATE SECRETS LOCALLY. DO NOT COMMIT .env!

# --- Application ---
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# --- Database ---
POSTGRES_PASSWORD=
ConnectionStrings__Default=Host=localhost;Port=5432;Database=beautyai;Username=beautyai;Password=

# --- AI & External Integrations (Null/Mock providers used when empty) ---
Gemini__ApiKey=
VnPay__TmnCode=
VnPay__HashSecret=
Zalo__OaId=

# --- Notifications ---
Smtp__Host=
Smtp__Port=
Smtp__User=
Smtp__Password=

# --- Admin Bootstrap (one-time seed only) ---
Admin__BootstrapPassword=
