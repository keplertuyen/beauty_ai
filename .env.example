# Environment variables template for BeautyAI (Backend + Local Docker)
# Copy to .env (chmod 600) and populate values locally. NEVER commit .env!

# --- Application ---
ASPNETCORE_ENVIRONMENT=Development
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://localhost:5001

# --- Database (set DATABASE_URL for Neon/Cloud or ConnectionStrings__DefaultConnection for local Docker) ---
POSTGRES_PASSWORD=
DATABASE_URL=
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=beautyai;Username=beautyai;Password=

# --- JWT Authentication (REQUIRED in Production: at least 32 random chars, e.g. `openssl rand -base64 48`) ---
JWT_SECRET=
JWT_ISSUER=beautyai-api
JWT_AUDIENCE=beautyai-clients
JWT_EXPIRATION_DAYS=7

# --- Admin Bootstrap (optional one-time provision/upgrade; password >= 8 chars) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=BeautyAI Administrator

# --- AI Skincare Provider ("dify" or "gemini"; falls back to rule-based if API key is empty) ---
AI_PROVIDER=dify
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
GEMINI_API_KEY=
