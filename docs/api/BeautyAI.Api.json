  "components": {
    "schemas": {
      "AddAllergyRequest": {
        "required": [
          "ingredientName",
          "note"
        ],
        "type": "object",
        "properties": {
          "ingredientName": {
            "type": "string"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AllergyItemDto": {
        "required": [
          "id",
          "ingredientName",
          "note"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ingredientName": {
            "type": "string"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AnalyzedIngredientDto": {
        "required": [
          "name",
          "inci_name",
          "category",
          "safety",
          "function",
          "benefits",
          "caution",
          "comedogenic_rating",
          "irritation_rating",
          "target_areas"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "inci_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caution": {
            "type": [
              "null",
              "string"
            ]
          },
          "comedogenic_rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "irritation_rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "target_areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuthResponse": {
        "required": [
          "token",
          "email",
          "fullName",
          "role"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "CautionDto": {
        "required": [
          "caution",
          "ingredient"
        ],
        "type": "object",
        "properties": {
          "caution": {
            "type": "string"
          },
          "ingredient": {
            "type": "string"
          }
        }
      },
      "CombinationWarningDto": {
        "required": [
          "warning",
          "ingredients_involved",
          "severity",
          "recommendation"
        ],
        "type": "object",
        "properties": {
          "warning": {
            "type": "string"
          },
          "ingredients_involved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      },
      "CompatibleSkinTypeDto": {
        "required": [
          "key",
          "score",
          "vi_name"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "vi_name": {
            "type": "string"
          }
        }
      },
      "ConditionEvaluationDto": {
