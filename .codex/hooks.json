{
  "PreToolUse": [
    {
      "matcher": "^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/protected-action-policy.py",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^Edit|Write|MultiEdit$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/check-doc-drift.py --changed-only",
          "timeout": 30
        }
      ]
    },
    {
      "matcher": "^Edit|Write|MultiEdit$",
      "hooks": [
        {
          "type": "command",
          "command": "python scripts/check-secrets.py",
          "timeout": 30
        }
      ]
    }
  ]
}
