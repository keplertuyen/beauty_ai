# Frontend environment variables template (Vite)
# In production (Vercel), set VITE_API_BASE_URL to your deployed backend API URL (e.g. https://beautyai-api.onrender.com/api/v1).
# Leave empty in local dev to use Vite's dev proxy (/api -> http://localhost:5001).
VITE_API_BASE_URL=

# Phase 1: product image file upload is disabled in production (ephemeral disk).
# Set to "true" only when running with persistent storage or local dev.
VITE_ENABLE_IMAGE_UPLOAD=false
